{
  "version": 2,
  "cleanUrls": true,
  "installCommand": "echo 'No dependencies needed'",
  "buildCommand": "echo 'Static assets ready'",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/all-frames/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/audio.mp3",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
